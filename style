
* {
    box-sizing: border-box;
}
body {
    margin: 0;
    font-family: Arial, Tahoma, sans-serif;
    background: #D3D3D3;
    color: #172033;
}
.topbar {
    background: #000000;
    color: white;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}
.brand {
    font-size: 20px;
    font-weight: bold;
}
.status {
    color: #bbf7d0;
    font-size: 14px;
}
.container {
    max-width: 1100px;
    margin: 50px auto;
    padding: 0 24px;
}
.eyebrow {
    color: #2563eb;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}
.h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.35;
    margin: 14px 0;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 34px;
}
.card, .welcome {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 5px 20px #1725540d;
}
.card p {
    color: #009900;
}
.card h2 {
    font-size: 25px;
    overflow-wrap: anywhere;
}

@media (max-width: 650px) {
    .stats {
        grid-template-columns: 1fr;
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }
}
